# ==========================================
# UniAttend 360 Enterprise Environment Config
# ==========================================

# 1. Database Configuration
UNIATTEND_DATABASE_URL=sqlite:///database/uniattend.db
# For Production PostgreSQL:
# UNIATTEND_DATABASE_URL=postgresql://postgres:SecurePassword2026!@localhost:5432/uniattend_db

# 2. JWT & Authentication Security
JWT_SECRET_KEY=UniAttend-Production-Secret-Key-Change-In-Prod-2026-SuperSecure!
ACCESS_TOKEN_EXPIRE_MINUTES=60
TEMP_MFA_TOKEN_EXPIRE_MINUTES=5

# 3. W3C WebAuthn / FIDO2 / Passkeys Configuration
WEBAUTHN_RP_ID=uniattend-360.vercel.app
WEBAUTHN_RP_NAME="UniAttend 360 (Smt. C.H.M. College)"
WEBAUTHN_ORIGIN=https://uniattend-360.vercel.app

# 4. Anti-Proxy Dynamic QR Cryptography Salt
ANTIPROXY_SECRET_SALT=UniAttend-AntiProxy-Salt-2026-SuperSecure

# 5. ML & Automated Nightly Job Schedules
ATTENDANCE_CRON_SCHEDULE="0 23 * * *"
AUDIT_LOG_RETENTION_DAYS=90
